# Server
ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
EXPOSE_DOCS=true
REQUIRE_LIVE_AI=false
MAX_UPLOAD_MB=8
MAX_TOTAL_UPLOAD_MB=16
RATE_LIMIT_PER_MINUTE=20
ANALYSIS_DB_PATH=data/navi360.db
ANALYSIS_RETENTION_DAYS=30

# NVIDIA NIM (required for live AI extraction, rewrite, and tagging)
# Create this key in NVIDIA's API Catalog. Never commit your real .env file.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_MODEL=qwen/qwen3.5-122b-a10b
TEXT_MODEL=deepseek-ai/deepseek-v4-pro
# Use this cheaper model for later high-volume classification if needed.
TEXT_FAST_MODEL=deepseek-ai/deepseek-v4-flash

# Bhashini TTS (required for live voice output). Configure these for production voice output.
BHASHINI_TTS_URL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
